# คัดลอกไฟล์นี้เป็น .env สำหรับรัน backend ในเครื่อง (local dev) เท่านั้น
# ห้าม commit ไฟล์ .env จริง (มี .gitignore กันไว้แล้ว)
#
# ค่านี้บน Render ให้ตั้งใน Render Dashboard → Environment แทน ไม่ใช่ไฟล์นี้

# จาก Supabase: Project Settings → Database → Connection string → Transaction pooler
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
